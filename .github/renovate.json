{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeDigest",
    ":automergeMinor",
    ":semanticCommitTypeAll(fix)"
  ],
  "internalChecksFilter": "strict",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "vulnerabilityAlerts": {
    "automerge": false,
    "minimumReleaseAge": null
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "labels": ["dependencies"],
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/packages/supi-skill-patches/package\\.json$/"],
      "matchStrings": [
        "\\\"mattpocock-skills\\\"\\s*:\\s*\\\"github:mattpocock/skills#v(?<currentValue>[^\\\"]+)\\\""
      ],
      "depNameTemplate": "mattpocock/skills",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Keep hk Pkl schema imports aligned with the mise tool",
      "managerFilePatterns": ["/^hk\\.pkl$/"],
      "matchStrings": [
        "amends\\s+\\\"package://github\\.com/jdx/hk/releases/download/v(?<currentValue>[^/\\\"]+)/hk@[^#\\\"]+#/Config\\.pkl\\\"\\s+import\\s+\\\"package://github\\.com/jdx/hk/releases/download/v[^/\\\"]+/hk@[^#\\\"]+#/Builtins\\.pkl\\\""
      ],
      "autoReplaceStringTemplate": "amends \"package://github.com/jdx/hk/releases/download/v{{{newValue}}}/hk@{{{newValue}}}#/Config.pkl\"\nimport \"package://github.com/jdx/hk/releases/download/v{{{newValue}}}/hk@{{{newValue}}}#/Builtins.pkl\"",
      "depNameTemplate": "hk",
      "packageNameTemplate": "jdx/hk",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>\\S+)"
    }
  ],
  "packageRules": [
    {
      "description": "Wait one week before proposing npm version updates; pnpm enforces the same cooldown for transitive dependencies.",
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Batch routine updates; later rules preserve dedicated dependency groups and review policies.",
      "groupName": "routine non-major dependencies",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "matchPackageNames": ["!mattpocock/skills", "!mattpocock-skills"]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Review GitHub Actions digest changes: a moved tag can retain its original release timestamp.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "automerge": false
    },
    {
      "groupName": "earendil-works",
      "matchPackageNames": ["@earendil-works/{/,}**"]
    },
    {
      "description": "Keep the Node.js runtime and its TypeScript definitions together.",
      "groupName": "node and @types/node",
      "separateMajorMinor": false,
      "matchDepNames": ["node", "@types/node"]
    },
    {
      "description": "vscode-languageserver-node monorepo",
      "groupName": "vscode-languageserver-node",
      "separateMajorMinor": false,
      "matchPackageNames": [
        "vscode-jsonrpc",
        "vscode-languageserver-protocol",
        "vscode-languageserver-types"
      ]
    },
    {
      "description": "Require review for upstream skill synchronization",
      "automerge": false,
      "matchPackageNames": ["mattpocock/skills", "mattpocock-skills"]
    },
    {
      "description": "Upgrade Pi manually. Workspace overrides keep Pi fixed during lock-file maintenance.",
      "enabled": false,
      "matchPackageNames": ["@earendil-works/pi-*", "@earendil-works/chord", "@mariozechner/pi-*"]
    }
  ]
}
