amends "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Builtins.pkl"

env {
  ["NODE_ENV"] = "development"
}

default_branch = "main"
fail_fast = true

exclude =
  List(
    "node_modules",
    ".agents",
    ".git",
    ".idea",
    ".claude",
    ".codex",
    ".pi",
    "dist",
    "build",
    "coverage"
  )

local precommit = new Mapping<String, Step> {
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["gitleaks"] = (Builtins.gitleaks) {
    // Scan only the content being committed, not the whole working tree.
    scan = "staged"
    prefix = List("pnpm", "-s", "exec")
  }
  ["check-added-large-files"] = (Builtins.check_added_large_files) {
    // Generated grammars and the bundled Tooling API; source metadata and pinned SHA-256 checks validate them.
    exclude = List(
      "packages/supi-tree-sitter/resources/grammars/typescript/tree-sitter-typescript.wasm",
      "packages/supi-tree-sitter/resources/grammars/tsx/tree-sitter-tsx.wasm",
      "packages/supi-tree-sitter/resources/grammars/sql/tree-sitter-sql.wasm",
      "packages/supi-code-intelligence/gradle-helper/lib/gradle-tooling-api-9.4.0.jar"
    )
  }

  ["biome"] = (Builtins.biome) {
    prefix = List("pnpm", "-s", "exec")
    // The builtin glob skips module and JSONC variants such as scripts/*.mjs and biome.jsonc.
    glob = List(
      "**/*.{js,mjs,cjs,jsx}",
      "**/*.{ts,mts,cts,tsx}",
      "**/*.{json,jsonc}"
    )
  }

  ["trailing-whitespace"] = Builtins.trailing_whitespace
}

local commitmsg = new Mapping<String, Step> {
  ["commitlint"] = new Step {
    check = "commitlint --edit {{commit_msg_file}}"
    prefix = "pnpm -s exec"
  }
}

// Keeps node_modules in sync after pulls, merges, rebases, and branch switches.
// A no-op install is fast; --frozen-lockfile never rewrites pnpm-lock.yaml.
// append-only keeps pnpm's log readable without a TTY; hk prints it after the hook run.
local installDependencies: Step = new {
  check = "pnpm install --frozen-lockfile --reporter=append-only"
  output_summary = "combined"
  stomp = true
}

local postcheckout = new Mapping<String, Step> {
  ["install-dependencies"] = (installDependencies) {
    step_condition = "is_branch_checkout"
  }
}

// `git pull` merges (post-merge) or, with pull.rebase/branch.*.rebase, rebases (post-rewrite).
local postmerge = new Mapping<String, Step> {
  ["install-dependencies"] = installDependencies
}

local postrewrite = new Mapping<String, Step> {
  ["install-dependencies"] = (installDependencies) {
    step_condition = "hook_args == 'rebase'"
  }
}

// stash = "none" because "git" and "patch-file" have data-loss bugs:
// - "git": discards fixer changes (#368), resurrects deleted files (#209), corrupts binaries (#743)
// - "patch-file": corrupts binaries (#743), removes untracked files (#209)
// Trade-off: unstaged changes in fixed files may get staged together.
// See: https://github.com/jdx/hk/discussions/209
hooks {
  ["commit-msg"] {
    steps = commitmsg
  }

  ["pre-commit"] {
    fix = true
    stash = "none"
    steps = precommit
  }

  ["post-checkout"] {
    steps = postcheckout
  }

  ["post-merge"] {
    steps = postmerge
  }

  ["post-rewrite"] {
    steps = postrewrite
  }

  ["fix"] {
    fix = true
    stash = "none"
    steps = precommit
  }
}
