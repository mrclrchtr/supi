# record.sh seeds demo stashes and restores the user's stash file afterwards.
Output "/tmp/supi-screenshots/supi-extras-stash.gif"
Set Width 1400
Set Height 520
Source "screenshots/tapes/_setup.tape"
Type "/supi-stash"
Sleep 500ms
Enter
Sleep 2s
Screenshot "screenshots/supi-extras-stash.png"
Source "screenshots/tapes/_teardown.tape"
