{
  "name": "@mrclrchtr/supi-prompt-improver",
  "version": "8.0.1",
  "description": "Command-based prompt improvement with user-approved drafts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrclrchtr/supi.git",
    "directory": "packages/supi-prompt-improver"
  },
  "homepage": "https://github.com/mrclrchtr/supi/tree/main/packages/supi-prompt-improver#readme",
  "bugs": {
    "url": "https://github.com/mrclrchtr/supi/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "prompt-improver",
    "prompt",
    "interactive"
  ],
  "type": "module",
  "files": [
    "src/**/*.ts",
    "!__tests__"
  ],
  "exports": {
    "./extension": {
      "types": "./src/extension.ts",
      "import": "./src/extension.ts"
    }
  },
  "pi": {
    "extensions": [
      "./src/extension.ts",
      "node_modules/@mrclrchtr/supi-ask-user/src/extension.ts"
    ]
  },
  "dependencies": {
    "@mrclrchtr/supi-ask-user": "workspace:*",
    "@mrclrchtr/supi-core": "workspace:*"
  },
  "bundledDependencies": [
    "@mrclrchtr/supi-ask-user",
    "@mrclrchtr/supi-core"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mrclrchtr/supi-test-utils": "workspace:*",
    "vitest": "5.0.3"
  }
}
