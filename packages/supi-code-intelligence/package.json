{
  "name": "@mrclrchtr/supi-code-intelligence",
  "version": "15.0.0",
  "description": "LSP and Tree-sitter code intelligence for the Pi coding agent: navigation, diagnostics, and semantic refactoring",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrclrchtr/supi.git",
    "directory": "packages/supi-code-intelligence"
  },
  "homepage": "https://github.com/mrclrchtr/supi/tree/main/packages/supi-code-intelligence#readme",
  "bugs": {
    "url": "https://github.com/mrclrchtr/supi/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "code-intelligence",
    "architecture",
    "call-graph",
    "impact-analysis",
    "refactoring",
    "lsp",
    "tree-sitter",
    "ast",
    "pi-agent",
    "language-server-protocol",
    "language-server"
  ],
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "src/**/*.ts",
    "gradle-helper/lib/*.jar",
    "gradle-helper/licenses/**",
    "gradle-helper/src/*.java",
    "gradle-helper/build.sh",
    "gradle-helper/README.md"
  ],
  "dependencies": {
    "@mrclrchtr/supi-code-runtime": "workspace:*",
    "@mrclrchtr/supi-core": "workspace:*",
    "@mrclrchtr/supi-lsp": "workspace:*",
    "@mrclrchtr/supi-tree-sitter": "workspace:*",
    "fast-xml-parser": "5.12.1",
    "ignore": "7.0.16",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  },
  "bundledDependencies": [
    "@mrclrchtr/supi-code-runtime",
    "@mrclrchtr/supi-core",
    "@mrclrchtr/supi-lsp",
    "@mrclrchtr/supi-tree-sitter",
    "fast-xml-parser",
    "ignore",
    "smol-toml",
    "yaml"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mrclrchtr/supi-test-utils": "workspace:*",
    "@types/node": "26.6.6",
    "vitest": "5.1.0"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "image": "https://raw.githubusercontent.com/mrclrchtr/supi/main/packages/supi-code-intelligence/assets/social-preview.png"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts",
    "./extension": "./src/extension.ts",
    "./headless": "./src/headless.ts",
    "./package.json": "./package.json"
  }
}
